# API service configuration
API_PORT=8000

# Vector database configuration
VECTOR_DB_PORT=8001

# OTEL configuration
OTEL_PPROF_PORT=1888
OTEL_PROMETHEUS_PORT=8888
OTEL_PROMETHEUS_EXPORTER_PORT=8889
OTEL_HEALTH_PORT=13133
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_ZPAGES_PORT=55679
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_AND_EVENT

# Jaeger configuration
JAEGER_UI_PORT=16686

# MLflow configuration
MLFLOW_PORT=5001
MLFLOW_EXPERIMENT_ID=0

# Prometheus configuration
PROMETHEUS_PORT=9090

# Loki configuration
LOKI_PORT=3100

# Grafana configuration
GRAFANA_PORT=3000

# Agent configuration
AGENT_PORT=8002
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Evals configuration
# judge model for the LLM-as-judge scorers (defaults to LLM_MODEL when empty)
EVAL_JUDGE_MODEL=gpt-4o
# share of /invoke requests scored by the online evaluation, between 0 and 1
EVAL_ONLINE_SAMPLE_RATE=1.0
